# ══════════════════════════════════════════════════════════════
# Ilumina Coruripe — variáveis de ambiente
#
# Copie para .env e preencha. O .env NÃO vai para o git.
# Em produção, cadastre estas mesmas chaves no painel do host
# (Vercel: Settings > Environment Variables / Netlify: Site configuration >
# Environment variables) e faça um novo deploy.
#
# Elas são lidas em BUILD TIME por scripts/build-config.mjs, que gera
# public/shared/config.js. Não existe leitura em runtime — o site é estático.
# ══════════════════════════════════════════════════════════════

# Deploy do Apps Script que recebe os reportes do cidadão
ILUMINA_ENDPOINT_CIDADAO=https://script.google.com/macros/s/COLE_O_ID_AQUI/exec

# Deploy do Apps Script do painel técnico (login, chamados, almoxarifado)
ILUMINA_ENDPOINT_TECNICO=https://script.google.com/macros/s/COLE_O_ID_AQUI/exec

# Portal que agrupa os sistemas da prefeitura (botão "voltar ao HUB")
ILUMINA_HUB_URL=https://hubcentralcrp.netlify.app
