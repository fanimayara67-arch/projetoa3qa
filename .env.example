# ══════════════════════════════════════════════════════════════
# Ilumina Coruripe — variáveis de ambiente
#
# Copie para .env e preencha. O .env NÃO vai para o git.
# ══════════════════════════════════════════════════════════════

# URL base da API Node.js. Use / para a mesma origem; vazio seleciona Apps Script.
ILUMINA_API_URL=http://localhost:3001

# Endpoints legados do Apps Script (ignorados quando ILUMINA_API_URL está definida)
ILUMINA_ENDPOINT_CIDADAO=https://script.google.com/macros/s/COLE_O_ID_AQUI/exec
ILUMINA_ENDPOINT_TECNICO=https://script.google.com/macros/s/COLE_O_ID_AQUI/exec

# Portal que agrupa os sistemas da prefeitura (botão "voltar ao HUB")
ILUMINA_HUB_URL=https://hubcentralcrp.netlify.app

# Variáveis exclusivas do Servidor Node.js (server/)
PORT=3001
# Conexão MySQL local. O banco deve existir; nenhum comando cria tabelas.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_iluminacao
DB_USER=ilumina_app
DB_PASSWORD=defina_uma_senha_local
# Onde as fotos ficam: disco (padrão, pasta UPLOAD_DIR) ou mysql (tabela fotos, migração 002).
# No Render o disco é apagado a cada deploy: use STORAGE_DRIVER=mysql.
STORAGE_DRIVER=disco
UPLOAD_DIR=./uploads/fotos
